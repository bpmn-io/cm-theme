{
  "name": "@bpmn-io/cm-theme",
  "version": "0.2.0",
  "description": "A CodeMirror 6 syntax highlighting theme for FEEL expressions",
  "scripts": {
    "all": "run-s lint build build:example test",
    "test": "karma start karma.conf.cjs",
    "start": "SINGLE_START=1 npm run dev",
    "dev": "run-p 'build -- watch' 'test -- --no-single-run --auto-watch'",
    "lint": "eslint .",
    "build": "microbundle -f modern --target node",
    "build:example": "vite build --config vite.config.example.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "codemirror",
    "feel",
    "theme",
    "syntax-highlighting"
  ],
  "author": "bpmn.io contributors",
  "type": "module",
  "source": "./src/index.ts",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "license": "MIT",
  "dependencies": {
    "@codemirror/language": "^6.12.3",
    "@lezer/highlight": "^1.2.3"
  },
  "peerDependencies": {
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0"
  },
  "devDependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@types/chai": "^5.2.3",
    "@types/karma-mocha": "^1.3.4",
    "@types/mocha": "^10.0.10",
    "chai": "^6.2.2",
    "codemirror": "^6.0.2",
    "eslint": "^9.39.4",
    "eslint-plugin-bpmn-io": "^2.3.1",
    "feelers": "^2.0.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher-2": "^3.3.0",
    "karma-debug-launcher": "^0.0.5",
    "karma-env-preprocessor": "^0.1.1",
    "karma-firefox-launcher": "^2.1.3",
    "karma-mocha": "^2.0.1",
    "karma-tldr-reporter": "^0.0.2",
    "karma-webpack": "^5.0.1",
    "lang-feel": "^4.0.2",
    "microbundle": "^0.15.1",
    "mocha": "^11.7.6",
    "npm-run-all2": "^9.0.2",
    "ts-loader": "^9.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16",
    "webpack": "^5.107.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bpmn-io/cm-theme.git"
  },
  "engines": {
    "node": ">= 20.12.0"
  },
  "files": [
    "dist"
  ]
}
